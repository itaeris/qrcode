APP_NAME="QR Generate"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://qrcode.aerisbeaute.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Sesuaikan dengan container MySQL yang sudah ada di network qrcode-network.
# DB_HOST = nama container, bukan 127.0.0.1.
DB_CONNECTION=mysql
DB_HOST=nama-container-mysql
DB_PORT=3306
DB_DATABASE=qrcode
DB_USERNAME=qrcode
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Sesuaikan dengan container Redis yang sudah ada di network qrcode-network.
# REDIS_HOST = nama container, bukan 127.0.0.1.
REDIS_CLIENT=phpredis
REDIS_HOST=nama-container-redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@qrcode.aerisbeaute.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
